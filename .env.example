POSTGRES_USER=trackride
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=trackride_development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

RAILS_ENV=development

OPENWEATHERMAP_API_KEY=

SEED_USER_NAME=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Producao. Em desenvolvimento nenhuma destas e necessaria.
#
# DATABASE_URL usa o esquema postgis://, nao postgresql:// — o
# activerecord-postgis-adapter registra o proprio esquema, e com o
# errado as colunas de geometria quebram.
DATABASE_URL=
SECRET_KEY_BASE=
FRONTEND_URL=

# O container sobe via Thruster, que escuta em HTTP_PORT e repassa
# para TARGET_PORT. A plataforma injeta PORT com a porta externa;
# sem TARGET_PORT o Puma disputaria a porta do Thruster.
HTTP_PORT=10000
TARGET_PORT=3000
WEB_CONCURRENCY=1

# Envio de email. BREVO_API_KEY tem prioridade: o plano gratuito do
# Render bloqueia as portas 25, 465 e 587, entao SMTP so funciona
# fora dele. Sem nenhuma das duas, o app nao envia e registra aviso.
BREVO_API_KEY=
MAILER_FROM=

SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
