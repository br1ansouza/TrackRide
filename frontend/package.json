{
	"name": "frontend",
	"private": true,
	"version": "0.3.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:standalone": "VITE_STANDALONE=1 vite build",
		"deploy": "vite build && wrangler deploy",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"cap:sync": "npm run build:standalone && npx cap sync android && find android/app/src/main/assets/public -name '*.gz' -delete",
		"cap:build": "npm run cap:sync && cd android && ./gradlew assembleDebug",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.6.2",
		"@playwright/test": "^1.65.1",
		"@skeletonlabs/skeleton": "^5.0.6",
		"@skeletonlabs/skeleton-svelte": "^5.0.6",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.58.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"wrangler": "^4.165.0"
	},
	"dependencies": {
		"@capacitor-community/background-geolocation": "^1.3.1",
		"@capacitor/android": "^8.6.2",
		"@capacitor/core": "^8.6.2",
		"@capacitor/geolocation": "^8.2.5",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/local-notifications": "^8.3.1",
		"@tanstack/svelte-query": "^6.4.4",
		"lucide-svelte": "^1.0.1",
		"maplibre-gl": "^6.19.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
