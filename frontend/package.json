{
	"name": "frontend",
	"private": true,
	"version": "0.3.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:standalone": "VITE_STANDALONE=1 vite build",
		"deploy": "vite build && wrangler deploy",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"cap:sync": "npm run build:standalone && npx cap sync android && find android/app/src/main/assets/public -name '*.gz' -delete",
		"cap:build": "npm run cap:sync && cd android && ./gradlew assembleDebug"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.3",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"wrangler": "^4.154.0"
	},
	"dependencies": {
		"@capacitor-community/background-geolocation": "^1.3.1",
		"@capacitor/android": "^8.5.3",
		"@capacitor/core": "^8.5.3",
		"@capacitor/geolocation": "^8.2.4",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/local-notifications": "^8.3.1",
		"@tanstack/svelte-query": "^6.3.6",
		"lucide-svelte": "^1.0.1",
		"maplibre-gl": "^6.16.0",
		"zod": "^4.6.7"
	}
}
